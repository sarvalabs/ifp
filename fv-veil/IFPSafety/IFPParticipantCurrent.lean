        ∧ ∀ (nc : node), ( (ctx.member nc s1 → (locked nc p1 ixn true v ∨ locked nc p1 ixn false v) ) ∧ (ctx.member nc s2 → (locked nc p2 ixn true v ∨ locked nc p2 ixn false v)) )) ) )
